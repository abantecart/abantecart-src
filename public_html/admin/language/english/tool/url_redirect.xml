    <definition>
        <key>entry_source</key>
        <value><![CDATA[Source<span class="help">Optional when Source Host is set (the rule then applies to any URL). Path without domain (/old-product), SEO keyword (old-product), query string (rt=product/product&product_id=12) or regular expression without delimiters (^/old/(.*)$)</span>]]></value>
    </definition>
    <definition>
        <key>entry_source_host</key>
        <value><![CDATA[Source Host<span class="help">Domain of the HTTP referer (the site the visitor came from) or IP address of the visitor. Leave empty to apply the rule to any visitor. Required if Source and Source HTTP Headers are empty.</span>]]></value>
    </definition>
    <definition>
        <key>entry_source_http_headers</key>
        <value><![CDATA[Source HTTP Headers<span class="help">Visitor request headers in the HTTP format, one per line: <i>User-Agent: Googlebot</i>. The rule works when ALL listed headers are present in the request and contain the given text (case-insensitive). Without a value (<i>Accept-Language:</i>) only the presence of the header is checked.</span>]]></value>
    </definition>
    <definition>
        <key>error_http_headers</key>
        <value><![CDATA[Source HTTP Headers must be in the HTTP format "Name: value", one header per line, up to 2048 characters in total!]]></value>
    </definition>
    <definition>
        <key>entry_action</key>
        <value><![CDATA[Action]]></value>
    </definition>
    <definition>
        <key>entry_target</key>
        <value><![CDATA[Target<span class="help">Relative (/new-product) or absolute (https://example.com/new-product) URL. Required for 301 and 302.</span>]]></value>
    </definition>
    <definition>
        <key>entry_keep_query</key>
        <value><![CDATA[Keep Query String<span class="help">Append the original query string to the target URL.</span>]]></value>
    </definition>
    <definition>
        <key>entry_priority</key>
        <value><![CDATA[Priority<span class="help">Rules are checked from lower to higher value. The first matched rule is applied.</span>]]></value>
    </definition>
    <definition>
        <key>entry_comment</key>
        <value><![CDATA[Comment]]></value>
