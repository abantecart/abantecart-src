        <key>error_not_found</key>
        <value><![CDATA[Redirect was not found.]]></value>
    </definition>
    <definition>
        <key>error_source</key>
        <value><![CDATA[Fill in Source, Source Host or Source HTTP Headers. Source must not exceed 2048 characters!]]></value>
    </definition>
    <definition>
        <key>error_regex</key>
        <value><![CDATA[Source is not a valid regular expression!]]></value>
    </definition>
    <definition>
        <key>error_query</key>
        <value><![CDATA[Source must be a query string, for example, rt=product/product&product_id=12]]></value>
    </definition>
    <definition>
        <key>error_duplicate</key>
        <value><![CDATA[A rule with the same source, source host and match type already exists.]]></value>
    </definition>
    <definition>
        <key>error_match_type</key>
        <value><![CDATA[Unknown match type!]]></value>
    </definition>
    <definition>
        <key>error_action</key>
